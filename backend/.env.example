# Example .env for backend
# Copy this to .env and update values for local development

# MongoDB connection string (with authSource=admin if using root user)
MONGO_URI=mongodb://root:123456@localhost:27017/?authSource=admin&authMechanism=SCRAM-SHA-1

# Default application admin (created on startup if missing)
DEFAULT_ADMIN_EMAIL=admin@sunmap.com
DEFAULT_ADMIN_PASSWORD=123456

# JWT configuration
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1h

# App port
PORT=3001

# API key for incoming weather logs (worker or producer should send this in header `x-api-key`)
WEATHER_API_KEY=local_dev_key
