# Example backend environment variables
# Copy this file to `backend/.env` and fill the values. Do NOT commit your .env file.

MONGO_URI=mongodb://root:123456@mongodb:27017/sunmap?authSource=admin
JWT_SECRET=replace_with_a_strong_secret
DEFAULT_ADMIN_EMAIL=admin@sunmap.com
DEFAULT_ADMIN_PASSWORD=changeme
BACKEND_API_KEY=replace_with_backend_api_key
# OpenWeatherMap API key (get it from https://openweathermap.org/)
OPENWEATHER_API_KEY=3ec3dab567267a7c60cdc64b71e1139c

PORT_FALLBACK=true


