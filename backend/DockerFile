## Multi-stage Dockerfile for production
## Stage 1: builder - installs devDependencies and builds the Nest app
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
COPY package*.json ./
RUN npm install

# Copy source and build
COPY . .
RUN npm run build

## Stage 2: runtime - smaller image with only production deps and compiled output
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Install only production dependencies
COPY package*.json ./
RUN npm install --production --no-audit --no-fund

# Copy compiled output from builder
COPY --from=builder /app/dist ./dist

# Copy any required assets (if you have public/static folders change as needed)
# COPY --from=builder /app/public ./public

# Healthcheck queries the local /health endpoint provided by the Nest app
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD ["node","-e","const http=require('http');const req=http.get('http://127.0.0.1:3001/health',res=>{if(res.statusCode>=200&&res.statusCode<500)process.exit(0);else process.exit(1)});req.on('error',()=>process.exit(1));setTimeout(()=>process.exit(1),4000);"]

EXPOSE 3001

CMD ["node", "dist/main.js"]